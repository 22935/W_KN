{
  "name": "wkn-journal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "studio": "node studio/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node --test tests/browser.e2e.mjs",
    "test:deployment": "node tests/deployment.mjs",
    "migrate:csdn": "node scripts/migrate-csdn.mjs",
    "sync": "node scripts/sync-remotes.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.0",
    "@astrojs/sitemap": "3.6.0",
    "@shikijs/rehype": "^3.21.0",
    "astro": "^5.16.0",
    "cheerio": "1.1.2",
    "express": "^5.1.0",
    "fflate": "^0.8.2",
    "gray-matter": "^4.0.3",
    "marked": "^16.4.0",
    "katex": "^0.16.27",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-math": "^6.0.0",
    "playwright": "^1.56.0",
    "sanitize-html": "^2.17.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@types/node": "^22.0.0",
    "pagefind": "^1.4.0",
    "typescript": "^5.9.0",
    "@playwright/test": "^1.56.0"
  }
