{
  "name": "yanshan",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@yanshan/site",
    "build": "npm run build:studio && npm run build:site",
    "build:site": "npm run build --workspace=@yanshan/site && node scripts/verify-site.mjs && pagefind --site dist",
    "build:studio": "npm run build --workspace=@yanshan/studio",
    "dev:studio": "npm run dev --workspace=@yanshan/studio",
    "check:studio": "npm run check --workspace=@yanshan/studio",
    "preview": "npm run preview --workspace=@yanshan/site",
    "check": "astro check && npm run check:studio",
    "studio": "node apps/api/server.mjs",
    "test:platform": "node --test tests/platform.e2e.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node --test tests/browser.e2e.mjs",
    "test:deployment": "node tests/deployment.mjs",
    "migrate:csdn": "node scripts/migrate-csdn.mjs",
    "sync": "node scripts/sync-remotes.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.0",
    "@astrojs/sitemap": "3.6.0",
    "@shikijs/rehype": "^3.21.0",
    "astro": "5.16.0",
    "cheerio": "1.1.2",
    "express": "^5.1.0",
    "fflate": "^0.8.2",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.27",
    "marked": "^16.4.0",
    "playwright": "^1.56.0",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-math": "^6.0.0",
    "sanitize-html": "^2.17.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "pagefind": "^1.4.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.0"
  }
}
